# Google OAuth 2.0 Client ID (Get from Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Swastha Express Backend API Base URL
VITE_API_BASE_URL=http://localhost:5001/api

# Swastha RAG (AI Search) service base URL — mounted inside the backend at
# /rag (same server/port as VITE_API_BASE_URL above), not a separate service.
VITE_RAG_BASE_URL=http://localhost:5001/rag/api
