# Same Supabase project as backend/.env (report_embeddings lives alongside
# reports/users). Fill with your own values in .env — never commit real ones.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini — used ONLY for embeddings (gemini-embedding-001).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — used for grounded answer generation (chat completion over
# the retrieved excerpts). Defaults to a free model (openai/gpt-oss-20b:free);
# see config/openrouter.js if that model gets deprecated.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Must match backend/.env's JWT_SECRET — this service verifies the same
# tokens the main backend issues, so it can trust req user identity without
# re-implementing login.
JWT_SECRET=your_jwt_secret_key_here

# App
PORT=3010
# Comma-separated list of origins allowed to call this service (the frontend
# dev server + deployed frontend URL).
CORS_ORIGIN=http://localhost:5173
