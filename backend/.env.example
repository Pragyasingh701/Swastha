# Express Server Port
PORT=5001

# Google OAuth 2.0 Client ID (Backend Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret — required for the redirect-based Google Sign-In flow
# (exchanges the authorization code for tokens). Get it from the same Google Cloud Console
# OAuth client as GOOGLE_CLIENT_ID above. You must also add this app's callback URL
# (e.g. http://localhost:5173/auth/google/callback, and your deployed frontend origin +
# /auth/google/callback) as an Authorized redirect URI on that client.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Secret Key for Signing JWT Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Supabase Database Configuration (Get from Supabase > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_REPORTS_BUCKET=reports

# Brevo (Sendinblue) HTTPS API Email Delivery Configuration (Sends to ANY recipient without domain verification)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Google Gemini API Key(s) — used for vision/OCR (doctor certificate parsing,
# report extraction) AND, by the merged-in RAG sub-app (backend/rag/), for
# embeddings (gemini-embedding-001) and grounded answer generation. Comma-
# separate multiple keys as GEMINI_API_KEYS to rotate on rate-limit (429);
# GEMINI_API_KEY (singular) also still works. Get a key at
# https://aistudio.google.com/app/apikey — a free-tier key works for local
# development, but a PAID-TIER key is required before this handles any real
# patient data: the free tier's rate/quota limits are shared across every
# user of the app (not per-request), so real traffic will exhaust it —
# by default this falls back to OpenRouter (see ALLOW_OPENROUTER_FALLBACK
# below) rather than interrupting service for patients.
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# GEMINI_API_KEYS=key_one,key_two

# OpenRouter — a THIRD-PARTY model provider, used only as a last-resort
# fallback when every configured Gemini key/model is exhausted. REQUIRED by
# default, since ALLOW_OPENROUTER_FALLBACK below defaults to true. Get a
# key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback flag. Defaults to true: when every configured Gemini key/model
# is exhausted, the RAG sub-app's AI failover client
# (backend/rag/config/aiClient.js) falls back to OpenRouter rather than
# failing the request — the AI-processing notice every user acknowledges
# before first use (backend/rag/config/aiNotices.js) discloses "an AI
# service" generically rather than naming Gemini specifically, so this
# fallback is already covered by that consent. Set to false to disable it
# (Gemini-only; a request fails gracefully with a friendly "try again"
# message on total Gemini exhaustion instead of trying OpenRouter). Any
# value other than exactly "false" (case-insensitive) is treated as true.
ALLOW_OPENROUTER_FALLBACK=true

# RAG used to be a separate standalone service (see git history / rag/README.md
# before the merge) reached over HTTP at its own port. It's now mounted
# in-process at /rag on this same server, so this only needs overriding if
# you're deliberately running RAG as an external service again.
# RAG_BASE_URL=http://localhost:5001/rag/api

# Sarvam AI — TTS (Bulbul v3) + ASR (Saaras) for the Module A voice layer.
# Comma-separated: keys are tried in order, and one that is exhausted or
# rejected is retired for the rest of the process while the next takes
# over (same convention as GEMINI_API_KEYS above). The singular
# SARVAM_API_KEY is still accepted for a one-key setup.
# Optional overall: without any key, or if Sarvam TTS otherwise fails, a
# turn simply has no audio (see ALLOW_EDGE_TTS_FALLBACK below for the one
# exception) — intake itself keeps working either way, text/tap only. ASR
# (speech-to-text) has no fallback provider at all and is simply
# unavailable without a working key.
SARVAM_API_KEYS=

# Fallback flag, same reasoning as ALLOW_OPENROUTER_FALLBACK above. Defaults
# to true: on a Sarvam TTS failure, ttsService.js falls back to Microsoft's
# speech.platform.bing.com (via edge-tts-universal) rather than the turn
# having no audio — covered by the same generic "an AI service" notice.
# Set to false to disable it (Sarvam-only; text/tap still works either way).
# Any value other than exactly "false" (case-insensitive) is treated as true.
ALLOW_EDGE_TTS_FALLBACK=true

# Shared secret protecting POST /api/intake-admin/sweep-abandoned (Module A
# audit fix, Issue #10 — marks intake_sessions stale for 48h+ as
# 'abandoned'). Trigger it on a schedule with an external cron service
# (e.g. cron-job.org, same as this server's existing /health keep-alive
# endpoints), sending this value in an X-Sweep-Secret header. Required for
# the sweep to run at all — without it, the endpoint always 503s rather
# than running unprotected.
INTAKE_SWEEP_SECRET=

# Ask Swastha's adaptive full-context mode (conversationalSearchService.js):
# below this many total characters of a patient's embeddable chunk text,
# skip embedding + vector search entirely and hand the model every chunk
# directly, instead of a similarity-ranked top-K subset. Optional, defaults
# to 100000 if unset.
# FULL_CONTEXT_MAX_CHARS=100000
