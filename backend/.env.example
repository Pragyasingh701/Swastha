# Express Server Port
PORT=5001

# Google OAuth 2.0 Client ID (Backend Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Secret Key for Signing JWT Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Supabase Database Configuration (Get from Supabase > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Brevo (Sendinblue) HTTPS API Email Delivery Configuration (Sends to ANY recipient without domain verification)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Google Gemini 2.0 Flash Vision AI API Key (100% Free API Key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key_here