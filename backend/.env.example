# Express Server Port
PORT=5001

# Google OAuth 2.0 Client ID (Backend Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret — required for the redirect-based Google Sign-In flow
# (exchanges the authorization code for tokens). Get it from the same Google Cloud Console
# OAuth client as GOOGLE_CLIENT_ID above. You must also add this app's callback URL
# (e.g. http://localhost:5173/auth/google/callback, and your deployed frontend origin +
# /auth/google/callback) as an Authorized redirect URI on that client.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Secret Key for Signing JWT Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Supabase Database Configuration (Get from Supabase > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_REPORTS_BUCKET=reports

# Brevo (Sendinblue) HTTPS API Email Delivery Configuration (Sends to ANY recipient without domain verification)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Google Gemini 2.0 Flash Vision AI API Key (100% Free API Key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key_here

# Cloudinary Storage Configuration (Get from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Swastha RAG service base URL — separate standalone service (see rag/README.md),
# used to trigger AI summary generation on report save.
RAG_BASE_URL=http://localhost:3010/api
