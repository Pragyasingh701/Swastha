# Express Server Port
PORT=5001

# Google OAuth 2.0 Client ID (Backend Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret — required for the redirect-based Google Sign-In flow
# (exchanges the authorization code for tokens). Get it from the same Google Cloud Console
# OAuth client as GOOGLE_CLIENT_ID above. You must also add this app's callback URL
# (e.g. http://localhost:5173/auth/google/callback, and your deployed frontend origin +
# /auth/google/callback) as an Authorized redirect URI on that client.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Secret Key for Signing JWT Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Supabase Database Configuration (Get from Supabase > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_REPORTS_BUCKET=reports

# Brevo (Sendinblue) HTTPS API Email Delivery Configuration (Sends to ANY recipient without domain verification)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Google Gemini API Key(s) — used for vision/OCR (doctor certificate parsing,
# report extraction) AND, by the merged-in RAG sub-app (backend/rag/), for
# embeddings (gemini-embedding-001). Comma-separate multiple keys as
# GEMINI_API_KEYS to rotate on rate-limit (429); GEMINI_API_KEY (singular)
# also still works. 100% free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key_here
# GEMINI_API_KEYS=key_one,key_two

# OpenRouter — required by the RAG sub-app for grounded answer generation
# (POST /rag/api/search and /rag/api/search/chat). Free key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# RAG used to be a separate standalone service (see git history / rag/README.md
# before the merge) reached over HTTP at its own port. It's now mounted
# in-process at /rag on this same server, so this only needs overriding if
# you're deliberately running RAG as an external service again.
# RAG_BASE_URL=http://localhost:5001/rag/api

# Sarvam AI — TTS (Bulbul v3) + ASR (Saaras) for the Module A voice layer.
# Comma-separated: keys are tried in order, and one that is exhausted or
# rejected is retired for the rest of the process while the next takes
# over (same convention as GEMINI_API_KEYS above). The singular
# SARVAM_API_KEY is still accepted for a one-key setup.
# Optional overall: without any key, TTS degrades to the edge-tts fallback
# voice and ASR is unavailable — intake itself keeps working either way.
SARVAM_API_KEYS=
