# Express Server Port
PORT=5001

# Google OAuth 2.0 Client ID (Backend Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Secret Key for Signing JWT Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Supabase Database Configuration (Get from Supabase > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Family Vault table name in Supabase
FAMILY_TABLE_NAME=family_vault

# Nodemailer SMTP Email Delivery Configuration (For Real OTPs & Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Swastha Support" <your_email@gmail.com>
FRONTEND_URL=http://localhost:5173